# stream_clipper settings - copy this file to .env and fill it in.
# Keep .env private (it's gitignored, never commit it).

# --- Twitch (required: used to find your VOD) ---
# Create a free app at https://dev.twitch.tv/console/apps
#   OAuth Redirect URL: http://localhost:3000
#   Category: Application Integration    Client Type: Confidential
TWITCH_CHANNEL=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Filled in automatically by:  python stream_clipper.py --twitch-login
# (only needed for --markers)
TWITCH_TOKEN=
TWITCH_REFRESH_TOKEN=

# --- Folders (leave empty for the defaults) ---
# Clips: default ~/Videos/StreamClips          e.g. CLIPPER_OUT=D:/StreamClips
CLIPPER_OUT=
# Downloaded VODs + analysis cache: default ~/.cache/stream_clipper
CLIPPER_CACHE=
